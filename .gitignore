# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# service account keys / 자격증명 (절대 commit 금지)
content/claude_code/mini_claude/secrets/

# claude code (토큰/개인 설정)
.claude/.mcp.json
.claude/settings.local.json
.mcp.json

# QnA 참조용 소스코드 (대용량)
content/claude_code/code_repository/

# mini_claude (Python 학습 프로젝트)
content/claude_code/mini_claude/.venv/
content/claude_code/mini_claude/__pycache__/
content/claude_code/mini_claude/**/__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
