# mini_claude 학습자 환경 — Vertex AI (Service Account JSON 인증)
# 이 파일을 .env 로 복사 (cp .env.example .env) 한 뒤 본인 값으로 편집하세요.
# .env 는 .gitignore 에 포함되므로 git 에 안 올라갑니다.

GOOGLE_APPLICATION_CREDENTIALS=secrets/your-sa-key.json
VERTEX_PROJECT_ID=your-gcp-project
VERTEX_LOCATION=global
MINI_LLM_MODEL=claude-opus-4-7

# 다른 백엔드를 쓰려면 (vLLM 등) 핸드북 10.5 참고
# MINI_LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8000/v1
