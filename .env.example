# ─── 인증 (전사 SSO — Microsoft Entra ID) ───
# 공개 배포 시 전 페이지를 회사 MS 계정 로그인 뒤로 게이트한다.
# 값이 비면 로컬 빌드/구동은 통과하되, 실제 로그인 시에만 필요.
#   AUTH_SECRET    : openssl rand -base64 33   (또는 npx auth secret)
#   *_ISSUER       : 단일 테넌트 제한 → https://login.microsoftonline.com/<TENANT_ID>/v2.0
#   Entra 앱 등록 Redirect URI: https://<배포도메인>/api/auth/callback/microsoft-entra-id
AUTH_SECRET=change-me
AUTH_MICROSOFT_ENTRA_ID_ID=your-entra-app-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-entra-app-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0

# === AWS Bedrock (Claude: Opus / Haiku) ===
# 인증: AWS_BEARER_TOKEN_BEDROCK 이 있으면 Bearer 토큰 인증을 사용. 비우면 표준 AWS
# 자격증명 체인(~/.aws/credentials, AWS_ACCESS_KEY_ID/SECRET, 또는 EC2 IAM role)으로
# SigV4 서명한다. 운영 환경에서는 IAM role 권장.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# 호출 기점 region. global inference profile 도 기점 region 을 요구한다.
# (Claude 모델 access 는 AWS 콘솔 > Bedrock > Model access 에서 요청)
AWS_REGION=ap-northeast-2

# Bedrock 모델 ID(inference-profile). 정확한 ID 는 다음에서 확인:
#   - AWS 콘솔 > Bedrock > Inference profiles
#   - aws bedrock list-inference-profiles --region $AWS_REGION
# region prefix(global. / us. / apac.)는 프로파일 종류에 따라 다르다.
OPUS_MODEL=global.anthropic.claude-opus-4-8
HAIKU_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# === Vertex AI (Gemini Flash 전용) ===
# Service Account JSON 키 경로 — 프로젝트 루트 기준 상대 경로.
# secrets/ 디렉토리는 .gitignore 등재됨. 없으면 gcloud ADC
# (`gcloud auth application-default login`)를 fallback 으로 사용.
#   - Cloud Run/GCP 컴퓨트에 배포하면 서비스 계정으로 keyless 인증되므로 이 값은 불필요.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/semi-handbook.json

# GCP 프로젝트 ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex 엔드포인트 region (global = 최신 Gemini 가 서빙되는 글로벌 엔드포인트)
CLOUD_ML_REGION=global

# Gemini 모델 ID
GEMINI_MODEL=gemini-3.5-flash

# ─── 데이터베이스 (게시판 / Q&A 로그) ───
# 없으면 게시판·로그 기능은 dormant (빌드·구동은 정상). 주입하면 자동으로 켜진다.
# 스키마는 db/schema.sql 을 한 번 적용:  psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL=postgres://user:password@localhost:5432/handbook

# 게시판 관리자 비밀번호 (글 상태 '완료' 처리 등)
ADMIN_PASSWORD=change-me
