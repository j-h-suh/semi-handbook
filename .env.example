# Vertex AI 자격증명 (Anthropic Claude + Gemini 공용)
#
# 1. Google Cloud 프로젝트 ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# 2. 리전 — global 권장 (Vertex 의 global endpoint, 가장 넓은 가용성)
CLOUD_ML_REGION=global

# 3. Service Account JSON 경로 — 프로젝트 루트 기준 상대 경로
#    secrets/ 디렉토리는 .gitignore 등재됨
GOOGLE_APPLICATION_CREDENTIALS=./secrets/semi-handbook.json
